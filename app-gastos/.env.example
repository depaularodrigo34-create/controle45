# Supabase - copie para .env e preencha com seus valores (nunca commite .env)
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_TOKEN_AQUI
# Compatibilidade com chave anon antiga (opcional)
# VITE_SUPABASE_ANON_KEY=eyJhbG...

# Para HTML puro sem Vite, você também pode definir via <meta> ou window.__ENV__
# Exemplo em index.html:
# <meta name="vite_supabase_url" content="https://SEU-PROJETO.supabase.co">
# <meta name="vite_supabase_publishable_key" content="sb_publishable_...">
